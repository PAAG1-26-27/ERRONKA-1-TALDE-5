            <a href="#helburuak" data-i18n="nav_goals">Helburuak</a>
            <button type="button" id="langToggle" class="botoi-hizkuntza" aria-label="Aldatu hizkuntza">EN</button>
        </nav>

    </header>


    <main>

        <!-- HASIERA -->

        <section class="azal nagusia" id="hasiera">

            <div class="azal-edukia">

                <span class="etiketa" data-i18n="hero_tag">ONGI ETORRI ERMUKO GAZTELEKURA</span>

                <h1 data-i18n="hero_title">
                    Gazteentzako espazioak,
                    <br>
                    <span>bizitzeko, ikasteko eta gozatzeko</span>
                </h1>

                <p data-i18n="hero_desc">
                    Ermuko Gaztelekua gazteekin egoteko, lagun berriak
                    egiteko, jarduera desberdinak egiteko eta
                    esperientzia berriak bizitzeko espazioa da.
                </p>

            </div>

        </section>


        <!-- NOR GARA -->

        <section class="atal edukiontzia" id="nor-gara">

            <div class="atal-goiburua">

                <span class="atal-etiketa">DENATEK</span>

                <h2 data-i18n="about_title">Nor gara?</h2>

                <p class="atal-sarrera" data-i18n="about_intro">
                    Gaztelekuen kudeaketan eta garapenean
                    lan egiten duen enpresa gara.
                </p>

            </div>

            <div class="bi-zutabe">

                <div>

                    <p data-i18n="about_p1">
                        Denatek gaztelekuen kudeaketa eta antolaketa
                        lantzen dituen enpresa da. Gure lana gazteentzako
                        espazio egokiak sortzea eta garatzea da,
                        aisialdi hezitzailea eta parte-hartzea sustatuz.
                    </p>

                    <p data-i18n="about_p2">
                        Gazteekin eta hezitzaileekin elkarlanean
                        aritzen gara, gazteen interesak eta beharrak
                        kontuan hartuz. Horretarako, jarduerak,
                        ekitaldiak eta irteerak antolatzen ditugu,
                        gazteek esperientzia berriak bizitzeko aukera izan dezaten.
                    </p>

                </div>

                <div class="nabarmendutako-kutxa">

                    <h3 data-i18n="about_box_title">Gure konpromisoa</h3>

                    <p data-i18n="about_box_desc">
                        Gazte guztientzako espazio irekiak,
                        seguruak, parte-hartzaileak eta
                        hezitzaileak sustatzea.
                    </p>

                </div>

            </div>

        </section>


        <!-- ZER DIRA GAZTELEKUAK -->

        <section class="atal atal-morea" id="zer-dira">

            <div class="edukiontzia">

                <div class="atal-goiburua">

                    <span class="atal-etiketa" data-i18n="what_tag">GAZTEENTZAKO GUNEAK</span>

                    <h2 data-i18n="what_title">Zer dira gaztelekuak?</h2>

                    <p class="atal-sarrera" data-i18n="what_intro">
                        Gaztelekuak nerabe eta gazteentzako
                        aisialdi eta topaketa guneak dira.
                        Denbora librea modu aktibo, sortzaile
                        eta hezitzailean pasatzeko espazioak dira.
                    </p>

                </div>

                <div class="bi-zutabe">

                    <div>

                        <h3 data-i18n="what_h1">Lagunekin egoteko espazioak</h3>

                        <p data-i18n="what_p1">
                            Gaztelekuetan gazteek lagunekin elkartu,
                            pertsona berriak ezagutu eta harreman
                            berriak sortzeko aukera dute. Giro
                            atsegin batean egoteko eta taldean
                            esperientziak partekatzeko lekuak dira.
                        </p>

                        <h3 data-i18n="what_h2">Aisialdi hezitzailea</h3>

                        <p data-i18n="what_p2">
                            Gaztelekuetan aisialdiaz gozatzeaz gain,
                            hainbat gaitasun lantzen dira. Jolasen,
                            tailerren eta jardueren bidez, gazteek
                            talde-lana, errespetua, komunikazioa
                            eta autonomia garatzen dituzte.
                        </p>

                        <h3 data-i18n="what_h3">Guztiontzako espazio irekiak</h3>

                        <p data-i18n="what_p3">
                            Gaztelekuak gazte guztientzako topaguneak
                            dira. Bertan, bakoitzak bere interesak,
                            ideiak eta proposamenak parteka ditzake,
                            besteak errespetatuz eta aniztasuna
                            baloratuz.
                        </p>

                    </div>

                    <div class="nabarmendutako-kutxa">

                        <h3 data-i18n="what_box_title">Zer aurki dezakegu gazteleku batean?</h3>

                        <p data-i18n="what_box_1">
                            <strong>Elkartzeko guneak:</strong>
                            Lagunekin egoteko eta hitz egiteko lekuak.
                        </p>

                        <p data-i18n="what_box_2">
                            <strong>Jolasak:</strong>
                            Mahai-jokoak, bideo-jokoak eta talde-jokoak.
                        </p>

                        <p data-i18n="what_box_3">
                            <strong>Tailerrak:</strong>
                            Eskulanak, sukaldaritza eta sormen-jarduerak.
                        </p>

                        <p data-i18n="what_box_4">
                            <strong>Ekitaldiak:</strong>
                            Jaiak, lehiaketak eta ospakizunak.
                        </p>

                        <p data-i18n="what_box_5">
                            <strong>Hezitzaileak:</strong>
                            Gazteei laguntzeko eta orientatzeko profesionalak.
                        </p>

                    </div>

                </div>

            </div>

        </section>


        <!-- GAZTELEKUAREN FUNTZIONAMENDUA -->

        <section class="atal edukiontzia">

            <div class="atal-goiburua">

                <span class="atal-etiketa" data-i18n="how_tag">EGUNEROKO BIZITZA</span>

                <h2 data-i18n="how_title">Nola funtzionatzen du gazteleku batek?</h2>

                <p class="atal-sarrera" data-i18n="how_intro">
                    Gaztelekuak gazteen beharretara egokitzen dira.
                    Eguneroko jarduerak, ordutegiak eta programazioak
                    antolatzen dira, gazteek aisialdiaz gozatzeko
                    eta parte hartzeko aukera izan dezaten.
                </p>

            </div>

            <div class="zerbitzu-sarea">

                <article class="zerbitzu-txartela">
                    <span class="zerbitzu-ikurra">01</span>
                    <h3 data-i18n="how_1_t">Harrera eta topaketa</h3>
                    <p data-i18n="how_1_d">
                        Gazteak gaztelekura iristen dira, lagunekin
                        elkartzen dira eta espazio desberdinak
                        erabiltzen dituzte.
                    </p>
                </article>

                <article class="zerbitzu-txartela">
                    <span class="zerbitzu-ikurra">02</span>
                    <h3 data-i18n="how_2_t">Programazioa</h3>
                    <p data-i18n="how_2_d">
                        Jarduerak eta tailerrak antolatzen dira,
                        gazteen interesak eta proposamenak kontuan hartuta.
                    </p>
                </article>

                <article class="zerbitzu-txartela">
                    <span class="zerbitzu-ikurra">03</span>
                    <h3 data-i18n="how_3_t">Hezitzaileen laguntza</h3>
                    <p data-i18n="how_3_d">
                        Hezitzaileek gazteei laguntzen diete,
                        orientazioa eskaintzen dute eta
                        elkarbizitza sustatzen dute.
                    </p>
                </article>

                <article class="zerbitzu-txartela">
                    <span class="zerbitzu-ikurra">04</span>
                    <h3 data-i18n="how_4_t">Parte-hartzea</h3>
                    <p data-i18n="how_4_d">
                        Gazteek jarduerak proposatu, ideiak partekatu
                        eta erabakietan parte hartzeko aukera dute.
                    </p>
                </article>

                <article class="zerbitzu-txartela">
                    <span class="zerbitzu-ikurra">05</span>
                    <h3 data-i18n="how_5_t">Elkarbizitza</h3>
                    <p data-i18n="how_5_d">
                        Errespetua, berdintasuna, elkarlana eta
                        taldeko harremanak lantzen dira.
                    </p>
                </article>

                <article class="zerbitzu-txartela">
                    <span class="zerbitzu-ikurra">06</span>
                    <h3 data-i18n="how_6_t">Ebaluazioa</h3>
                    <p data-i18n="how_6_d">
                        Gazteen iritziak entzuten dira, jarduerak
                        aztertzen dira eta hobekuntzak proposatzen dira.
                    </p>
                </article>

            </div>

        </section>


        <!-- JARDUERAK -->

        <section class="atal atal-morea" id="jarduerak">

            <div class="edukiontzia">

                <div class="atal-goiburua">

                    <span class="atal-etiketa" data-i18n="act_tag">AISIALDIA ETA DIBERTSIOA</span>

                    <h2 data-i18n="act_title">Zer jarduera egiten dira gaztelekuetan?</h2>

                    <p class="atal-sarrera" data-i18n="act_intro">
                        Gaztelekuetan jarduera ugari egiten dira.
                        Jarduera horiek gazteen adinera, gustuetara
                        eta interesetara egokitzen dira.
                    </p>

                </div>

                <div class="zerbitzu-sarea">

                    <article class="zerbitzu-txartela">
                        <span class="zerbitzu-ikurra">01</span>
                        <h3 data-i18n="act_1_t">Kirola eta mugimendua</h3>
                        <p data-i18n="act_1_d">
                            Kirol-jolasak, txapelketak, dantza
                            eta taldeko jarduerak.
                        </p>
                    </article>

                    <article class="zerbitzu-txartela">
                        <span class="zerbitzu-ikurra">02</span>
                        <h3 data-i18n="act_2_t">Eskulanak eta sormena</h3>
                        <p data-i18n="act_2_d">
                            Marrazketa, pintura, eskulanak,
                            dekorazioa eta eskulan-tailerrak.
                        </p>
                    </article>

                    <article class="zerbitzu-txartela">
                        <span class="zerbitzu-ikurra">03</span>
                        <h3 data-i18n="act_3_t">Jokoak eta bideo-jokoak</h3>
                        <p data-i18n="act_3_d">
                            Mahai-jokoak, kontsola-jokoak,
                            lehiaketak eta taldeko erronkak.
                        </p>
                    </article>

                    <article class="zerbitzu-txartela">
                        <span class="zerbitzu-ikurra">04</span>
                        <h3 data-i18n="act_4_t">Sukaldaritza</h3>
                        <p data-i18n="act_4_d">
                            Errezetak prestatzea, gozogintza
                            eta sukaldaritza-tailer parte-hartzaileak.
                        </p>
                    </article>

                    <article class="zerbitzu-txartela">
                        <span class="zerbitzu-ikurra">05</span>
                        <h3 data-i18n="act_5_t">Musika eta zinema</h3>
                        <p data-i18n="act_5_d">
                            Karaokeak, musika-ekitaldiak,
                            filmak eta zinema-gauak.
                        </p>
                    </article>

                    <article class="zerbitzu-txartela">
                        <span class="zerbitzu-ikurra">06</span>
                        <h3 data-i18n="act_6_t">Irteerak eta ekitaldiak</h3>
                        <p data-i18n="act_6_d">
                            Txangoak, bisita kulturalak,
                            jaiak eta jarduera bereziak.
                        </p>
                    </article>

                </div>

            </div>

        </section>


        <!-- HELBURUAK -->

        <section class="atal edukiontzia" id="helburuak">

            <div class="atal-goiburua">

                <span class="atal-etiketa" data-i18n="goal_tag">GAZTEEN GARAPENA</span>

                <h2 data-i18n="goal_title">Gaztelekuen helburuak</h2>

                <p class="atal-sarrera" data-i18n="goal_intro">
                    Gaztelekuen helburua ez da soilik gazteak
                    entretenitzea. Haien garapen pertsonala,
                    soziala eta emozionala sustatzea ere bada.
                </p>

            </div>

            <div class="onurak-sarea">

                <div>
                    <h3 data-i18n="goal_1_t">Autonomia</h3>
                    <p data-i18n="goal_1_d">
                        Erabakiak hartzen eta norberaren
                        erantzukizunak lantzen ikastea.
                    </p>
                </div>

                <div>
                    <h3 data-i18n="goal_2_t">Harremanak</h3>
                    <p data-i18n="goal_2_d">
                        Lagun berriak egitea eta harreman
                        osasungarriak garatzea.
                    </p>
                </div>

                <div>
                    <h3 data-i18n="goal_3_t">Sormena</h3>
                    <p data-i18n="goal_3_d">
                        Irudimena lantzea eta ideia berriak
                        sortzeko aukerak izatea.
                    </p>
                </div>

                <div>
                    <h3 data-i18n="goal_4_t">Berdintasuna</h3>
                    <p data-i18n="goal_4_d">
                        Aniztasuna errespetatzea eta pertsona
                        guztien parte-hartzea sustatzea.
                    </p>
                </div>

                <div>
                    <h3 data-i18n="goal_5_t">Talde-lana</h3>
                    <p data-i18n="goal_5_d">
                        Besteekin elkarlanean aritzea eta
                        helburu komunak lortzea.
                    </p>
                </div>

                <div>
                    <h3 data-i18n="goal_6_t">Parte-hartzea</h3>
                    <p data-i18n="goal_6_d">
                        Iritziak ematea eta komunitateko
                        jardueretan aktiboki parte hartzea.
                    </p>
                </div>

            </div>
			
