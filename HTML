				<a href="../Gasteleku/gasteleku.html" class="botoia" data-i18n="btn_ermua">
					Ezagutu Ermuko Gaztelekua
				</a>
			</div>
			
        </section>


        <!-- HARREMANETARAKO -->

        <section class="harremanetarako" id="izen-ematea">

            <div class="edukiontzia harreman-edukia">

                <div>

                    <span class="atal-etiketa" data-i18n="contact_tag">HARREMANETAN JARRI</span>

                    <h2 data-i18n="contact_title">Ermuko Gaztelekuari buruz gehiago jakin nahi duzu?</h2>

                    <p data-i18n="contact_desc">
                        Gurekin harremanetan jarri eta Ermuko Gaztelekuaren
                        inguruko informazio gehiago eskatu.
                    </p>

                </div>

            </div>
				
        </section>

    </main>


