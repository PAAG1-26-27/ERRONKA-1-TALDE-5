        <a href="Sarrera.html" class="logotipo-esteka">
            <img src="Argazkiak/Logo_EnpresaIzena.png"
                 alt="Denatek logotipoa"
                 class="logotipoa">
        </a>

        <nav class="nabigazioa">
            <a href="#hasiera" data-i18n="nav_home">Hasiera</a>
            <a href="#nor-gara" data-i18n="nav_about">Nor gara</a>
            <a href="#zer-dira" data-i18n="nav_what">Gaztelekuak</a>
